// 複製這個檔案為 secrets.h 並填入你的實際值，然後重新編譯燒錄。
// secrets.h 已被 .gitignore 忽略，請千萬不要把它提交到公開倉庫。
//
//   cp secrets.h.example secrets.h
//
// 本檔案與 lib/services/trigger_signer.dart 的 HMAC 演算法必須保持一致：
//   canonical payload = "<ts>:<nonce>:<action>"  (秒級 Unix 時間戳, 十進位, 無空白)
//   action            = "toggle" 或 "half_open"
//   signature         = HMAC-SHA256(GATE_TRIGGER_SECRET, payload) 的小寫 hex

#pragma once

